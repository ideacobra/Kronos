# memecoin_bot configuration
#
# Copy this file to `.env` in the repo root (or export these as real
# environment variables) before running `python -m memecoin_bot.cli ...`.
# `.env` is already gitignored -- never commit real secrets, including a
# generated SOLANA_PRIVATE_KEY.
#
# SAFETY REMINDER: paper trading (simulated, no real funds) by default.
# Real live trading (see the "Live trading" section below) is entirely
# OFF unless you explicitly set ENABLE_LIVE_TRADING=true, configure a
# funded wallet + private RPC URL, and pass a one-time CLI risk flag on
# every `run --live` invocation. X posting is a transparent, factual trade
# *log*, not a way to promote any token, in both modes.

# ---------------------------------------------------------------------------
# Chain / market data (DexScreener + GeckoTerminal need NO API key)
# ---------------------------------------------------------------------------
CHAIN_ID=solana
DEXSCREENER_BASE_URL=https://api.dexscreener.com
GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2
HTTP_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# Candidate discovery / gating filters (hard pass/fail, not scored)
# ---------------------------------------------------------------------------
MIN_LIQUIDITY_USD=10000
MIN_TOKEN_AGE_MINUTES=10
MAX_TOKEN_AGE_HOURS=72
MAX_CANDIDATES_PER_SCAN=40

# ---------------------------------------------------------------------------
# FOMO/momentum scoring weights (must be non-negative; auto-normalized)
# ---------------------------------------------------------------------------
WEIGHT_VOLUME_SURGE=0.35
WEIGHT_PRICE_MOMENTUM=0.30
WEIGHT_BUY_PRESSURE=0.20
WEIGHT_BOOST_BONUS=0.15
MIN_SCORE_TO_BUY=60

# ---------------------------------------------------------------------------
# Optional Kronos model confirmation signal
# Requires the root requirements.txt (torch/pandas/etc.) to be installed.
# If unavailable/misconfigured/offline, the bot logs a warning and falls
# back to the pure FOMO score -- it will never crash because of this.
# ---------------------------------------------------------------------------
USE_KRONOS_SIGNAL=false
KRONOS_MODEL_NAME=NeoQuasar/Kronos-small
KRONOS_TOKENIZER_NAME=NeoQuasar/Kronos-Tokenizer-base
KRONOS_DEVICE=cpu
KRONOS_LOOKBACK_CANDLES=100
KRONOS_PRED_LEN=12
KRONOS_TIMEFRAME=minute
KRONOS_TIMEFRAME_AGGREGATE=5
# Predicted moves smaller than this (%) are treated as "agrees" either way.
KRONOS_MIN_AGREEMENT_PCT=0
# If true, a BUY is skipped outright when Kronos disagrees with momentum.
KRONOS_REQUIRE_AGREEMENT=true

# ---------------------------------------------------------------------------
# Risk management (paper trading)
#
# Going live with a small budget (e.g. $15)? `run --live` automatically
# applies more conservative recommended defaults for these five variables
# UNLESS you set them explicitly here first: MAX_OPEN_POSITIONS=1,
# POSITION_SIZE_PCT=0.35, MAX_POSITION_USD=5.5,
# DAILY_REALIZED_LOSS_LIMIT_USD=6.5, STARTING_BALANCE_USD=15. That sizes
# each position at roughly a third of a $15 wallet (~$5, leaving a buffer
# for Solana fees across a few trades) and stops trading for the day once
# realized losses hit ~$6.50 (well before all $15 is at risk). Uncomment
# and tune the lines below if you want to set these explicitly instead of
# relying on the automatic live-mode defaults.
# ---------------------------------------------------------------------------
STARTING_BALANCE_USD=1000
POSITION_SIZE_PCT=0.05
MAX_POSITION_USD=100
STOP_LOSS_PCT=0.15
TAKE_PROFIT_PCT=0.40
MAX_HOLD_MINUTES=180
MAX_OPEN_POSITIONS=5
DAILY_REALIZED_LOSS_LIMIT_USD=150
SIMULATED_SLIPPAGE_PCT=0.01
SIMULATED_FEE_PCT=0.003
# MAX_OPEN_POSITIONS=1
# POSITION_SIZE_PCT=0.35
# MAX_POSITION_USD=5.5
# DAILY_REALIZED_LOSS_LIMIT_USD=6.5
# STARTING_BALANCE_USD=15

# ---------------------------------------------------------------------------
# Storage / loop timing
# ---------------------------------------------------------------------------
DB_PATH=memecoin_bot.db
SCAN_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------------
# X (Twitter) posting -- OFF by default. Posting only ever becomes "live"
# when ENABLE_X_POSTING=true AND all four X_* credentials below are set.
# Otherwise every post is only logged (dry-run), never sent over the network.
# Create these in the X Developer Portal (OAuth 1.0a user context / "read
# and write" app permissions): https://developer.twitter.com/en/portal/dashboard
# ---------------------------------------------------------------------------
ENABLE_X_POSTING=false
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_MIN_SECONDS_BETWEEN_POSTS=60
X_MAX_POSTS_PER_HOUR=10
X_POST_PERIODIC_SUMMARY=true
X_SUMMARY_INTERVAL_MINUTES=240

# ---------------------------------------------------------------------------
# Live trading (Solana / Jupiter) -- OFF by default. See
# memecoin_bot/README.md "Going Live" for the full step-by-step checklist
# and risk disclosures (rug pulls, MEV/sandwich bots, slippage, smart
# contract risk, irreversible transactions) before ever setting these.
#
# `run --live` refuses to start unless ALL of: ENABLE_LIVE_TRADING=true,
# SOLANA_PRIVATE_KEY set, SOLANA_RPC_URL set to a PRIVATE (non-public) RPC,
# AND you pass --i-understand-live-trading-risk on that specific invocation
# (never persisted -- must be typed every time).
# ---------------------------------------------------------------------------
ENABLE_LIVE_TRADING=false
# Generate with: python -m memecoin_bot.cli wallet new
# This writes SOLANA_PRIVATE_KEY directly into this file -- never share it,
# never commit it, never paste it anywhere. Whoever has this key controls
# 100% of the funds in this wallet.
SOLANA_PRIVATE_KEY=
# A PRIVATE RPC URL is required for live trading -- public endpoints (e.g.
# api.mainnet-beta.solana.com) are refused outright. Get a free-tier URL
# from Helius (https://www.helius.dev/) or another provider (QuickNode,
# Alchemy, Triton) and paste the full URL here (it usually embeds an API
# key as a query parameter -- keep this file private, same as the key above).
SOLANA_RPC_URL=
# Jupiter Swap API endpoints (quote then swap). Defaults work out of the
# box on the free/no-API-key tier; override only if Jupiter's URLs change
# or you have a paid API key with a different base URL.
JUPITER_QUOTE_URL=https://api.jup.ag/swap/v1/quote
JUPITER_SWAP_URL=https://api.jup.ag/swap/v1/swap
# 400 bps = 4% slippage tolerance -- conservative for illiquid memecoins.
LIVE_SLIPPAGE_BPS=400
# "auto" uses Jupiter's recommended/estimated priority fee. Set to an
# integer lamports value instead (e.g. 20000) to pin a fixed fee.
LIVE_PRIORITY_FEE_LAMPORTS=auto
# How long to wait for on-chain confirmation before treating a submitted
# transaction's outcome as unknown (never assumed to have failed OR
# succeeded -- see memecoin_bot/README.md).
LIVE_CONFIRMATION_TIMEOUT_SECONDS=60
# SOL always left unspent as a buffer for tx fees / ATA rent across a few
# trades -- never counted as spendable balance for sizing a live trade.
LIVE_WALLET_BALANCE_BUFFER_SOL=0.01
